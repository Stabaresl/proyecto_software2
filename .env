# ── Email (ms-notificaciones / Nodemailer) ───────────────────────
# Si se deja vacío, el servicio simula el envío (imprime en consola).
# Para envío real, completa con tus credenciales SMTP:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@talentbridge.com


